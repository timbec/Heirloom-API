# Postgres.app runs as your macOS user with no password.
DATABASE_URL=postgresql+asyncpg://localhost:5432/heirloom

# Signs the admin session cookie. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true in staging/production (HTTPS)
SECURE_COOKIES=false

# Comma-separated
CORS_ORIGINS=http://localhost:3000,https://heirloom-staging.storywriter.net,https://heirloom.storywriter.net

# Groq. Keep model names here, never in code: Groq retires models without notice.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SCORING_MODEL=openai/gpt-oss-20b
# gpt-oss models think before answering; low keeps scoring fast. Leave blank for other models.
GROQ_SCORING_REASONING_EFFORT=low
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
