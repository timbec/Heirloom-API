# Postgres.app runs as your macOS user with no password.
DATABASE_URL=postgresql+asyncpg://localhost:5432/heirloom

# Comma-separated
CORS_ORIGINS=http://localhost:3000,https://heirloom-staging.storywriter.net,https://heirloom.storywriter.net

# Groq. Keep model names here, never in code: Groq retires models without notice.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SCORING_MODEL=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
